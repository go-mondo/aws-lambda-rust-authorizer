{
  "name": "@go-mondo/aws-lambda-rust-authorizer",
  "version": "0.2.0",
  "description": "AWS Lambda Rust authorizers for Mondo Identity, with AWS CDK constructs.",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@12.3.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/go-mondo/aws-lambda-rust-authorizer.git"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cdk-rest-api": {
      "types": "./dist/cdk-rest-api/construct.d.ts",
      "import": "./dist/cdk-rest-api/construct.js"
    }
  },
  "files": [
    "dist",
    "Cargo.toml",
    "Cargo.lock",
    "src/**/*.rs"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "biome check --write .",
    "lint": "biome check .",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "cargo-lambda-cdk": "^0.0.36"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.253.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "aws-cdk-lib": "^2.277.0",
    "constructs": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,jsonc,md}": "biome check --write --no-errors-on-unmatched",
    "*.rs": "rustfmt --edition 2024"
  }
}
